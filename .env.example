NODE_ENV=production
PORT=5000

# ---- Aiven PostgreSQL (copy values from the Aiven console) ----
DB_HOST=pg-anwar-nexora-app1.c.aivencloud.com
DB_PORT=15728
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=PASTE_YOUR_NEW_ROTATED_PASSWORD_HERE
DB_SSL=true
# Download "CA certificate" from Aiven and save it as server/ca.pem
DB_CA_CERT_PATH=./ca.pem
# ...or paste it on one line with \n instead of newlines (useful on Render/Railway):
# DB_CA_CERT=-----BEGIN CERTIFICATE-----\nMIIE...\n-----END CERTIFICATE-----
# Aiven free plan allows 15 connections; keep the pool below that
DB_POOL_MAX=8
# alter = auto-update columns (use on first deploys), safe = create missing tables only, none = skip
DB_SYNC=alter

# ---- Security ----
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d
# comma-separated web origins; mobile & desktop apps don't need to be listed
CORS_ORIGINS=https://app.yourdomain.com,http://localhost:5173
# first account becomes admin; set false afterwards so only admins add users
ALLOW_SIGNUP=true

# ---- Seed script ----
ADMIN_NAME=Anwar
ADMIN_EMAIL=dev.anwar.official@gmail.com
ADMIN_PASSWORD=ChangeThis@123
